# Copy this file to `.env.local` and fill in your local settings.
# `.env.local` is ignored by git.

# --- Provider selection ---
# openai | openrouter
LLM_PROVIDER=openrouter

# --- API keys ---
# For OpenAI mode:
# OPENAI_API_KEY=

# For OpenRouter mode:
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_APP_NAME=generative_agents_evolution

# --- Network proxy ---
# If enabled and no explicit value is set, defaults to 127.0.0.1:7890
LLM_PROXY_ENABLED=true
LLM_PROXY=127.0.0.1:7890

# --- Optional API base override ---
# LLM_API_BASE=https://openrouter.ai/api/v1

# --- Model routing ---
LLM_CHAT_MODEL=deepseek/deepseek-v4-flash
LLM_GPT4_MODEL=deepseek/deepseek-v4-flash
LLM_COMPLETION_MODEL=deepseek/deepseek-v4-flash
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_REQUEST_TIMEOUT=60

# --- Project metadata ---
OPENAI_KEY_OWNER=lizhiyuan
GA_DEBUG=true

# --- Startup defaults (for manual run prompts/reference) ---
GA_DEFAULT_FORK_SIM=base_the_ville_isabella_maria_klaus
GA_DEFAULT_NEW_SIM=p0-smoke
GA_DEFAULT_RUN_STEPS=10
GA_FRONTEND_URL=http://127.0.0.1:8000/
GA_HOURLY_SCHEDULE_RETRIES=1
